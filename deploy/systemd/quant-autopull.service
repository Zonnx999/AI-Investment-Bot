# CI 게이트 자동 배포 (scripts/server_autopull.sh). sudoers: ubuntu ALL=(root) NOPASSWD: /usr/bin/systemctl restart quant-bot
[Unit]
Description=AI-Investment-Bot auto-pull (CI-gated deploy + health check + rollback)
After=network-online.target
Wants=network-online.target
OnFailure=quant-alert@autopull.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/AI-Investment-Bot
ExecStart=/home/ubuntu/AI-Investment-Bot/scripts/server_autopull.sh
TimeoutStartSec=900
